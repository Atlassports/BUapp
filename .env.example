# Session signing secret. Generate with: openssl rand -hex 32
SIDEKICK_SECRET=dev-secret-change-me

# Where the SQLite file lives. Swap for a Postgres URL when you outgrow it.
SIDEKICK_DB=.data/sidekick.db

# Email delivery for @bu.edu verification codes.
# Leave unset in development: codes are printed to the server console.
# RESEND_API_KEY=
# MAIL_FROM="Sidekick <verify@yourdomain.com>"

# Campus the instance is gated to. Keep this as bu.edu until BU has liquidity.
ALLOWED_EMAIL_DOMAIN=bu.edu
