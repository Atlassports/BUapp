# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Next.js loads .env automatically.
# ---------------------------------------------------------------------------

# Signs verification codes and the pending-signup cookie.
# REQUIRED in production — the app refuses to start without a real one, because
# the default would let anyone forge a signup for any @bu.edu address.
# Generate with:  openssl rand -hex 32
SIDEKICK_SECRET=

# Where the SQLite file lives. Swap for a Postgres URL when you outgrow it.
SIDEKICK_DB=.data/sidekick.db

# Campus the instance is gated to. Keep this bu.edu until BU has liquidity.
ALLOWED_EMAIL_DOMAIN=bu.edu

# ---------------------------------------------------------------------------
# Email — required for real signups
# ---------------------------------------------------------------------------
# Leave RESEND_API_KEY unset in development and codes print to the server
# console instead of sending. In production a missing key is a hard failure,
# so a broken signup can never look like a working one.
#
# To send for real:
#   1. Create a key at https://resend.com/api-keys
#   2. Verify a domain at https://resend.com/domains
#   3. Set MAIL_FROM to an address at that verified domain
#
# Step 2 is not optional. Until a domain is verified, Resend only delivers to
# the address that owns the API key — so it will send to you and silently
# refuse every student. Run `npm run mail:test -- someone@bu.edu` to confirm.
RESEND_API_KEY=
MAIL_FROM="Sidekick <verify@yourdomain.com>"

# ---------------------------------------------------------------------------
# Moderation
# ---------------------------------------------------------------------------
# Comma-separated emails that can reach /admin. An allowlist rather than a
# database flag, so revoking access never depends on the database.
ADMIN_EMAILS=you@bu.edu

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Web Push, for browsers and Home Screen installs. Generate with:
#   npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# APNs, for the App Store build. From developer.apple.com → Certificates,
# Identifiers & Profiles → Keys. Create a key with APNs enabled and download
# the .p8 once — Apple will not let you download it again.
#   APNS_PRIVATE_KEY takes the .p8 contents with newlines written as \n
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=edu.bu.sidekick
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# Where the app is deployed. The native iOS shell loads this URL.
NEXT_PUBLIC_APP_URL=https://sidekick-bu.fly.dev

# ---------------------------------------------------------------------------
# Payments (Stripe)
# ---------------------------------------------------------------------------
# Without these the app runs normally and charges nothing — the escrow UI
# explains that payments are off rather than pretending to take money.
#
# Test keys first (sk_test_/pk_test_). Switch to live only once you have a real
# business entity and have read the Connect platform agreement.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the Stripe dashboard → Developers → Webhooks, after adding an endpoint
# for POST /api/webhooks/stripe. Locally: stripe listen --forward-to ...
STRIPE_WEBHOOK_SECRET=

# Shared secret for the scheduled auto-release job, which pays taskers whose
# poster went quiet. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Map (optional)
# ---------------------------------------------------------------------------
# With a token the map uses real Mapbox tiles; without one it falls back to the
# drawn campus map, which costs nothing and always works. Restrict the token to
# your domain in the Mapbox dashboard — it ships to the browser by design.
NEXT_PUBLIC_MAPBOX_TOKEN=
