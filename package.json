{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:reset": "rm -f .data/sidekick.db && npm run db:seed",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "mail:test": "tsx --env-file-if-exists=.env scripts/check-mail.ts",
    "share": "node scripts/share.mjs",
    "db:repair": "tsx --env-file-if-exists=.env scripts/repair-emails.ts",
    "test": "tsx --test tests/*.test.ts",
    "preview": "next build && node scripts/preview.mjs",
    "push:keys": "node scripts/push-keys.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/web-push": "^3.6.4",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.3"
  }
}
